# Environment
NODE_ENV=development

# Server
PORT=3000
API_PREFIX=api

# Database (PostgreSQL)
# Local dev: role `timbio` created directly in the Homebrew/local Postgres instance.
# If you use `docker compose up -d postgres` instead, point this at that container
# (user/password/db come from POSTGRES_* below in that case).
DATABASE_URL=postgresql://timbio:timbio_dev_password@localhost:5432/timbio_dev?schema=public
POSTGRES_USER=timbio
POSTGRES_PASSWORD=timbio_dev_password
POSTGRES_DB=timbio_dev
POSTGRES_PORT=5432

# Test database (used by prisma migrate + jest against a throwaway DB, never the dev DB)
TEST_DATABASE_URL=postgresql://timbio:timbio_dev_password@localhost:5432/timbio_test?schema=public

# Logging
LOG_LEVEL=debug

# JWT (generar secretos con: openssl rand -base64 48)
JWT_ACCESS_SECRET=change-me-in-local-env-min-32-chars-long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-too-in-local-env-min-32-chars
JWT_REFRESH_EXPIRES_IN=7d

# Rate limiting (ventana en ms + máximo de requests por ventana por IP)
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100

# CORS (lista separada por comas). Vacío = permisivo sin credentials, solo
# válido fuera de producción — en NODE_ENV=production es obligatorio, el
# arranque falla si queda vacío (ver src/config/env.validation.ts).
CORS_ORIGINS=

# URL pública de la app/frontend, usada para armar los links de los correos
APP_URL=http://localhost:3000

EMAIL_VERIFICATION_EXPIRES_IN=24h
PASSWORD_RESET_EXPIRES_IN=1h

# SMTP (si SMTP_HOST se deja vacío, los correos se escriben al log en vez de
# enviarse — suficiente para desarrollo local)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Semana Santa de Timbío <no-reply@timbio.local>

# Días que se conservan los refresh tokens revocados/expirados antes de purgarlos
TOKEN_CLEANUP_RETENTION_DAYS=30

# Firebase Storage (media: fotos, video, audio, PDFs — ver src/storage).
# Sacar de: Firebase Console > Configuración del proyecto > Cuentas de
# servicio > Generar nueva clave privada (JSON). Dejar vacío en dev/test
# para que MediaService/StorageService avisen en vez de fallar el arranque.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# La private_key del JSON tal cual, con \n literales (no saltos de línea reales)
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=
MEDIA_MAX_FILE_SIZE_MB=50
